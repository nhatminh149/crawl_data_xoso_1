{{#max3dLoop}}
<div class='max3d' style="margin-top: 15px;">
    <div class='breadcrumb3d' style="background-color: white; border-bottom: none" >
       <p>{{get result.max3d_title titleIndex}}</p>
    </div>
    <div class='breadcrumb13d' style="border-top: none;">
       <p style="font-weight: bold; color: #F40819;">{{get result.max3d_link linkIndex}}</p>
    </div>
    <table class='xs-table3d'>
        <tbody>
            <tr class='prize-row'>
                <td class='label-col' style='background-color: #F5F5F5;'>G1</td>
                <td style='font-size:40px;color:#F40819;font-weight:bold;background-color: #F5F5F5;'>
                 &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;{{get result.G1 g1Start}} &nbsp; &nbsp; &nbsp; &nbsp; {{get result.G1 (add g1Start 1)}}
                </td>
            </tr>
            <tr class='prize-row'>
                <td class='label-col' style='background-color: white;'>G.2</td>
                <td style='font-size:30px;color:black;font-weight:bold;'>
                     &nbsp; &nbsp;{{get result.G2vKK g2Start}} &nbsp; &nbsp; &nbsp; &nbsp; {{get result.G2vKK (add g2Start 1)}} &nbsp; &nbsp; &nbsp; &nbsp;
                     &nbsp; &nbsp;{{get result.G2vKK (add g2Start 2)}} &nbsp; &nbsp; &nbsp; &nbsp; {{get result.G2vKK (add g2Start 3)}}
                </td>
            </tr>
            <tr class='prize-row'>
                <td class='label-col' style='background-color: #F5F5F5;'>G.3</td>
                <td style='font-size:30px;color:black;font-weight:bold; background-color: #F5F5F5;'>
                    &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;{{get result.G3 g3Start}}    &nbsp; &nbsp; &nbsp; &nbsp; {{get result.G3 (add g3Start 1)}} &nbsp; &nbsp; &nbsp; &nbsp; {{get result.G3 (add g3Start 2)}}<br>
                    &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;{{get result.G3 (add g3Start 3)}} &nbsp; &nbsp; &nbsp; &nbsp; {{get result.G3 (add g3Start 4)}} &nbsp; &nbsp; &nbsp; &nbsp; {{get result.G3 (add g3Start 5)}}
                </td>
            </tr>
            <tr class='prize-row'>
                <td class='label-col' style='background-color: white;'>KK</td>
                <td style='font-size:30px;color:black;font-weight:bold;'>
                     &nbsp; &nbsp;{{get result.G2vKK (add g2Start 4)}} &nbsp; &nbsp; &nbsp; &nbsp; {{get result.G2vKK (add g2Start 5)}} &nbsp; &nbsp; &nbsp; &nbsp; {{get result.G2vKK (add g2Start 6)}} &nbsp; &nbsp; &nbsp; &nbsp;{{get result.G2vKK (add g2Start 7)}}<br>
                     &nbsp; &nbsp;{{get result.G2vKK (add g2Start 8)}} &nbsp; &nbsp; &nbsp; &nbsp; {{get result.G2vKK (add g2Start 9)}} &nbsp; &nbsp; &nbsp; &nbsp; {{get result.G2vKK (add g2Start 10)}} &nbsp; &nbsp; &nbsp; &nbsp;{{get result.G2vKK (add g2Start 11)}}
                </td>
            </tr>
        </tbody>
    </table>
    <div style="width: 600px; height: 40px; border: 1px solid #CCCCCC;background-color: #F5F5F5;">
