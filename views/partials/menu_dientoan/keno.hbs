<script>
        document.addEventListener('DOMContentLoaded', function() {
            const countdownElement = document.getElementById('countdown-timer');
            const START_HOUR = 6;
            const END_HOUR = 21;
            const END_MINUTE = 55;
            const INTERVAL_MINUTES = 5;

            function formatTime(minutes, seconds) {
                const min = String(minutes).padStart(2, '0');
                const sec = String(seconds).padStart(2, '0');
                return `${min}:${sec}`;
            }

            function updateCountdown() {
                const now = new Date();
                const currentHour = now.getHours();
                const currentMinute = now.getMinutes();
                const isOperatingTime = currentHour >= START_HOUR && 
                                        (currentHour < END_HOUR || (currentHour === END_HOUR && currentMinute <= END_MINUTE));

                if (!isOperatingTime) {
                    countdownElement.textContent = "00:00"; 
                    return; 
                }
                const minutesSinceStart = (currentHour - START_HOUR) * 60 + currentMinute;
                const nextDrawMinuteOffset = Math.ceil((minutesSinceStart + 1) / INTERVAL_MINUTES) * INTERVAL_MINUTES;
                
                const targetMinute = (nextDrawMinuteOffset % 60);
                const targetHour = START_HOUR + Math.floor(nextDrawMinuteOffset / 60);

                let targetDate = new Date();
                targetDate.setHours(targetHour, targetMinute, 0, 0);
                if (targetDate.getTime() < now.getTime()) {
                    targetDate.setMinutes(targetDate.getMinutes() + INTERVAL_MINUTES);
                }
                if (targetHour > END_HOUR || (targetHour === END_HOUR && targetMinute > END_MINUTE)) {
                    countdownElement.textContent = "00:00"; 
                    return;
                }
                const diffTime = targetDate.getTime() - now.getTime();
                const totalSeconds = Math.floor(diffTime / 1000);
                const displayMinutes = Math.floor(totalSeconds / 60);
                const displaySeconds = totalSeconds % 60;
                countdownElement.textContent = formatTime(displayMinutes, displaySeconds);
            }
            updateCountdown();
            setInterval(updateCountdown, 1000);
        });
    </script>