                    </tr>
                    <tr class="prize-row">
                        <td class="label-col" style="background-color: white; text-align: center; vertical-align: middle;">G.2</td>
                        <td style="font-size: 30px; text-align: center; vertical-align: middle; color: black;">
                            {{get result.G2_XSMB_90ngay g2Start}} &nbsp;&nbsp;&nbsp;&nbsp; {{get result.G2_XSMB_90ngay (add g2Start 1)}}
