                    </tr>
                    <tr class="prize-row">
                        <td class="label-col" style="text-align: center; vertical-align: middle;">G.5</td>
                        <td style="font-size: 30px; text-align: center; vertical-align: middle; color: black; background-color: #F5F5F5;">
                            {{get result.G3vG5vG6_XSMB_90ngay (add g5Start 0)}} &nbsp;&nbsp;&nbsp;&nbsp; {{get result.G3vG5vG6_XSMB_90ngay (add g5Start 1)}} &nbsp;&nbsp;&nbsp;&nbsp; {{get result.G3vG5vG6_XSMB_90ngay (add g5Start 2)}}<br />
                            {{get result.G3vG5vG6_XSMB_90ngay (add g5Start 3)}} &nbsp;&nbsp;&nbsp;&nbsp; {{get result.G3vG5vG6_XSMB_90ngay (add g5Start 4)}} &nbsp;&nbsp;&nbsp;&nbsp; {{get result.G3vG5vG6_XSMB_90ngay (add g5Start 5)}}
                        </td>
                    </tr>
                    <tr class="prize-row">
                        <td class="label-col" style="background-color: white; text-align: center; vertical-align: middle;">G.6</td>
                        <td style="font-size: 30px; text-align: center; vertical-align: middle; color: black;">
                            {{get result.G3vG5vG6_XSMB_90ngay (add g6Start 0)}} &nbsp;&nbsp;&nbsp;&nbsp; {{get result.G3vG5vG6_XSMB_90ngay (add g6Start 1)}} &nbsp;&nbsp;&nbsp;&nbsp; {{get result.G3vG5vG6_XSMB_90ngay (add g6Start 2)}}
                        </td>
                    </tr>
                    <tr class="prize-row">
                        <td class="label-col" style="text-align: center; vertical-align: middle;">G.7</td>
                        <td style="font-size: 30px; text-align: center; vertical-align: middle; color: #d32f2f; background-color: #F5F5F5;">
                            {{get result.G7_XSMB_90ngay (add g7Start 0)}} &nbsp;&nbsp;&nbsp;&nbsp; {{get result.G7_XSMB_90ngay (add g7Start 1)}} &nbsp;&nbsp;&nbsp;&nbsp; {{get result.G7_XSMB_90ngay (add g7Start 2)}} &nbsp;&nbsp;&nbsp;&nbsp; {{get result.G7_XSMB_90ngay (add g7Start 3)}}
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        {{/xsmb30ngayLoop}}
