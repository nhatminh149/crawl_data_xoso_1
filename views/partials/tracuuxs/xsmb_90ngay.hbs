                        </td>
                    </tr>
                    <tr class="prize-row">
                        <td class="label-col" style="background-color: white; text-align: center; vertical-align: middle;">G.4</td>
                        <td style="font-size: 30px; text-align: center; vertical-align: middle; color: black;">
                            {{get result.G4_XSMB_90ngay (add g4Start 0)}} &nbsp;&nbsp; {{get result.G4_XSMB_90ngay (add g4Start 1)}} &nbsp;&nbsp; {{get result.G4_XSMB_90ngay (add g4Start 2)}} &nbsp;&nbsp; {{get result.G4_XSMB_90ngay (add g4Start 3)}}
