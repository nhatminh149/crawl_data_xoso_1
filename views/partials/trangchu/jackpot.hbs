<div class='mega-result-container'>
    <div class='header_jp'>
        <div class='header_jp_h1'>
            <h1>Xổ số Mega 6/45</h1>
        </div>
    </div>

    <div class='jackpot-estimate'>
        <div class='jackpot-title'><h1 style='margin-top: 10px;'>KẾT QUẢ JACKPOT
                ƯỚC TÍNH</h1></div>
        <div class='jackpot-value-box'>
            <div class='jackpot-value-box2'>
                <span class='jackpot-value'>{{get result.jackpot 0}}</span>
            </div>
        </div>
    </div>

    <div class='next-draw-info'>
        <span class='next-draw-date'>{{get result.para_open_next 0}}</span>
    </div>
    <div class="w-[500px] h-[60px]" style="text-align: left;">
    <div class='draw-details0' style="color: #CC0000;margin-left: 10px;font-weight: bold;">
        {{get result.jackpot_day 0}}
    </div>
    <div class='draw-details' style="margin-top: 5px;margin-left: 10px;">
        {{get result.para_text_black_bold 0}}
    </div>
    </div>

    <div class='winning-numbers'>
        <div class='number-ball'>{{slice result.number_ball.[0] 0 2}}</div>
        <div class='number-ball'>{{slice result.number_ball.[0] 2 4}}</div>
        <div class='number-ball'>{{slice result.number_ball.[0] 4 6}}</div>
        <div class='number-ball'>{{slice result.number_ball.[0] 6 8}}</div>
        <div class='number-ball'>{{slice result.number_ball.[0] 8 10}}</div>
        <div class='number-ball'>{{slice result.number_ball.[0] 10 12}}</div>

    </div>
    <p class='note'>
        Các con số dự thưởng phải trùng với số kết quả nhưng không cần theo đúng
        thứ tự
    </p>

    <table class='prize-table'>
        <thead>
            <tr>
                <th>Giải thưởng</th>
                <th>Trùng khớp</th>
                <th>Số lượng giải</th>
                <th>Giá trị giải (đ)</th>
            </tr>
        </thead>
        <tbody>
            <tr class='jackpot-row'>
                <td>Jackpot</td>
                <td>
                    <span class='match-dot'></span>
                    <span class='match-dot'></span>
                    <span class='match-dot'></span>
                    <span class='match-dot'></span>
                    <span class='match-dot'></span>
                    <span class='match-dot'></span>
                </td>
                <td>{{get result.text_right 0}}</td>
                <td>{{get result.text_right 1}}</td>
            </tr>
            <tr>
                <td>Giải 1</td>
                <td>
                    <span class='match-dot'></span>
                    <span class='match-dot'></span>
                    <span class='match-dot'></span>
                    <span class='match-dot'></span>
                    <span class='match-dot'></span>
                </td>
                <td>{{get result.text_right 2}}</td>
                <td>{{get result.text_right 3}}</td>
            </tr>
            <tr>
                <td>Giải 2</td>
                <td>
                    <span class='match-dot'></span>
                    <span class='match-dot'></span>
                    <span class='match-dot'></span>
                    <span class='match-dot'></span>
                </td>
                <td>{{get result.text_right 4}}</td>
                <td>{{get result.text_right 5}}</td>
            </tr>
            <tr>
                <td>Giải 3</td>
                <td>
                    <span class='match-dot'></span>
                    <span class='match-dot'></span>
                    <span class='match-dot'></span>
                </td>
                <td>{{get result.text_right 6}}</td>
                <td>{{get result.text_right 7}}</td>
            </tr>
        </tbody>
    </table>

    <ul class='stats-links'>
        <li><a href='#'>Xem thống kê
                <span class='link-highlight'>Lần xuất hiện xổ số Mega</span></a></li>
        <li><a href='#'>Xem thống kê
                <span class='link-highlight'>Theo thứ XS Mega</span></a></li>
    </ul>

    <p class='footer-note'>
        Kết quả xổ số
        <span class='link-highlight'>Mega</span>
        mở thưởng vào các ngày thứ 4/6/CN hàng tuần lúc 18h30
    </p>
</div>

